#!/bin/bash

# ======================================================================
# ГЛАВНЫЙ ФАЙЛ МЕНЮ
# ======================================================================

# Подключаем все общие переменные и функции
source /usr/local/bin/_config_and_utils.sh

# Каталог репозитория вычисляется от самого скрипта, а не задан жёстко.
# При запуске через симлинк /usr/local/bin/vsm readlink -f приводит к
# реальному файлу внутри репозитория.
#
# Иначе установка под прежним именем (/root/VPS-main-menu), обновившись до
# версии с жёстким /root/VSM, теряла бы свой каталог: проверка обновлений
# молча выключалась, а пункт обновления просто выходил из меню — починить
# изнутри было уже нельзя.
VSM_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

function check_for_updates {
    # Переходим в физическую папку репозитория, чтобы Git видел .git
    cd "$VSM_DIR" || return
    
    # Проверяем наличие .git
    [ ! -d .git ] && return

    # Запрашиваем инфо с GitHub
    git fetch origin main &>/dev/null
    
    # Считаем именно отставание, а не любое расхождение: при сравнении
    # хешей уведомление всплывало и когда локальные коммиты просто не
    # отправлены — со списком из нуля пунктов.
    local total
    total=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)

    if [ "$total" -gt 0 ]; then
        echo -e "${YELLOW}======================================================"
        echo -e "📢  ${GREEN}ДОСТУПНО ОБНОВЛЕНИЕ${NC} ${CYAN}(коммитов: $total)${NC}"
        echo -e "${YELLOW}------------------------------------------------------"
        # Только заголовки и не больше пяти. Раньше выводилось «%s%n %b» —
        # вместе с телом коммита. На пяти коммитах это 149 строк, экран
        # улетал вверх, а при автозапуске меню пользоваться сервером было
        # нельзя, пока не пролистаешь всё.
        # Обрезка через sed, а не cut -c: cut считает байты, и кириллица
        # рвалась посреди символа, оставляя в выводе «конв<?>».
        git log HEAD..origin/main --max-count=5 --pretty=format:'%s' 2>/dev/null \
            | sed -e 's/\(.\{58\}\).*/\1…/' -e 's/^/  • /'
        echo ""
        if [ "$total" -gt 5 ]; then
            echo -e "  ${CYAN}… и ещё $((total - 5)); полный список — git log в каталоге VSM${NC}"
        fi
        echo -e "${YELLOW}------------------------------------------------------"
        echo -e "Нажмите ${GREEN}[8]${NC} в меню для автообновления."
        echo -e "======================================================${NC}"
        # Пауза, чтобы уведомление не стёрлось командой clear. С таймаутом:
        # при автозапуске на каждом входе по SSH бессрочное ожидание
        # блокировало бы работу с сервером.
        read -t 15 -p "Enter или 15 сек до продолжения..." || true
        echo ""
    fi
}

# --- ГЛАВНОЕ МЕНЮ ---
function show_menu {
    clear
    echo -e "${CYAN}======================================================${NC}"
    echo -e "${CYAN}             🚀  МЕНЮ УПРАВЛЕНИЯ СЕРВЕРОМ  🚀        ${NC}"
    echo -e "${CYAN}======================================================${NC}"
    
    # --- БЛОК ОТОБРАЖЕНИЯ ХАРАКТЕРИСТИК ---
    # --- СБОР ДАННЫХ В СТИЛЕ BENCH.SH ---
    # CPU
    if command -v lscpu &> /dev/null; then
        CPU_MODEL=$(lscpu 2>/dev/null | grep 'Model name:' | head -n 1 | awk -F ':' '{print $2}' | sed -e 's/^[ \t]*//')
        CPU_CORES=$(nproc)
        CPU_FREQ=$(lscpu | grep -i "CPU MHz" | awk -F': ' '{print $2}' | xargs)
		if [ -z "$CPU_FREQ" ]; then
    CPU_FREQ=$(grep -m1 "cpu MHz" /proc/cpuinfo | awk -F': ' '{print $2}' | xargs)
fi
        CPU_CACHE=$(lscpu | grep "L3 cache" | awk '{print $3$4}')
    else
        CPU_MODEL="Не определено"; CPU_CORES="?"; CPU_FREQ="?"; CPU_CACHE="?"
    fi

    # AES-NI / Virtualization
    AES_NI=$(grep -qw aes /proc/cpuinfo && echo -e "${GREEN}✓ Включено${NC}" || echo -e "${RED}✗ Выключено${NC}")
    VM_X=$(grep -Eow "vmx|svm" /proc/cpuinfo > /dev/null && echo -e "${GREEN}✓ Включено${NC}" || echo -e "${RED}✗ Выключено${NC}")
    VIRT=$(systemd-detect-virt 2>/dev/null || echo "Unknown")

    # DISK & MEM
    RAM_TOTAL_RAW=$(grep MemTotal /proc/meminfo | awk '{print $2/1024/1024}')
    RAM_TOTAL=$(printf "%.1f" $RAM_TOTAL_RAW)
    MEM_FREE=$(grep MemAvailable /proc/meminfo | awk '{print $2/1024/1024}')
    MEM_USED=$(echo "$RAM_TOTAL - $MEM_FREE" | bc -l)
    
    DISK_USAGE=$(df -h --output=size,used / | tail -n 1)
    read -r D_TOTAL D_USED <<< "$DISK_USAGE"

    # SYSTEM INFO
    UPTIME_RAW=$(uptime -p | sed 's/up //')
    UPTIME=$(echo "$UPTIME_RAW" | sed -e 's/years\?/лет/g' -e 's/weeks\?/недель/g' -e 's/days\?/дн./g' -e 's/hours\?/час./g' -e 's/minutes\?/мин./g')
    LOAD_AVG=$(awk '{print $1", "$2", "$3}' /proc/loadavg)
    OS_NAME=$(grep "PRETTY_NAME" /etc/os-release | cut -d'"' -f2)
    ARCH=$(uname -m)
    KERNEL=$(uname -r)
    TCP_CC=$(sysctl net.ipv4.tcp_congestion_control | awk '{print $3}')

    # NETWORK & GEO
    #
    # Таймауты обязательны, и по той же причине, что у timeout 2 в
    # xui_panel_url: это меню открывается из ~/.bashrc при КАЖДОМ входе по SSH,
    # уже после clear. Без --max-time curl ждёт по умолчанию до 300 с на
    # подключение, и при заблокированном ipinfo.io администратор получал пустой
    # экран на минуты — дважды подряд, потому что запроса два. Заблокированный
    # ipinfo.io — не гипотеза, а ровно тот случай, ради которого ставят VSM.
    #
    # У ipinfo.io схема указана явно: без неё curl идёт по http. У ip-api.com
    # ниже оставлен http сознательно — SSL там только в платном тарифе, и
    # https молча вернул бы пустоту. Раз ответ приходит открытым текстом и
    # правится кем угодно на пути, а печатается через echo -e, который
    # разворачивает escape-последовательности в терминале root, — все значения
    # оттуда обязаны пройти через _addr_clean. См. ниже.
    IPV4=$(curl -s4 --connect-timeout 2 --max-time 4 https://ipinfo.io/ip 2>/dev/null)
    # Значение уходит и в URL, и в вывод — оставляем только то, что похоже на
    # адрес. Раньше при неудаче сюда попадала строка «✗ Offline» ВМЕСТЕ с
    # ANSI-кодами и подставлялась в URL следующего запроса.
    printf '%s' "$IPV4" | grep -qE '^[0-9a-fA-F.:]+$' || IPV4=""
    IPV6=$(get_public_ipv6)
    GEO_DATA=""
    [ -n "$IPV4" ] && GEO_DATA=$(curl -s --connect-timeout 2 --max-time 4 \
        "http://ip-api.com/json/$IPV4?lang=ru&fields=status,message,country,regionName,city,isp,org,as" 2>/dev/null)
    COUNTRY=$(echo "$GEO_DATA" | jq -r '.country' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"country":"\K[^"]+')
    LOC=$(echo "$GEO_DATA" | jq -r '.city' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"city":"\K[^"]+')
    REG=$(echo "$GEO_DATA" | jq -r '.regionName' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"regionName":"\K[^"]+')
    ORG=$(echo "$GEO_DATA" | jq -r '.org' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"org":"\K[^"]+')
    if [ -z "$ORG" ] || [ "$ORG" == "null" ]; then
        ORG=$(echo "$GEO_DATA" | jq -r '.isp' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"isp":"\K[^"]+')
    fi
    # Всё, что пришло из сети, чистим перед echo -e — как домены и учётки.
    # Значение подконтрольно тому, кто сидит на пути открытого HTTP, а строка
    # печатается при каждом входе по SSH: без чистки туда кладут ESC-коды и
    # перерисовывают экран, вплоть до поддельного приглашения ввода пароля.
    # Длину ограничиваем, чтобы длинный ORG не разъезжал таблицу.
    COUNTRY=$(_addr_clean "$COUNTRY" | cut -c1-48)
    LOC=$(_addr_clean "$LOC" | cut -c1-48)
    REG=$(_addr_clean "$REG" | cut -c1-48)
    ORG=$(_addr_clean "$ORG" | cut -c1-64)
    # Пустой IPv4 — это «не дозвонились», и так и печатаем. Раньше строка с
    # ANSI-кодами лежала в самой переменной и уезжала в URL запроса.
    [ -n "$IPV4" ] || IPV4="${RED}✗ Offline${NC}"
    # --- ВЫВОД МЕНЮ В СТИЛЕ BENCH.SH ---
    echo -e "${BLUE}----------------------------------------------------------------------${NC}"
    echo -e " 💻  Модель процессора   : ${YELLOW}$CPU_MODEL${NC}"
    echo -e " 🧠  Ядра процессора     : ${YELLOW}$CPU_CORES @ ${CPU_FREQ} MHz${NC}"
    echo -e " 🗄️   Кэш процессора      : ${YELLOW}$CPU_CACHE${NC}"
    echo -e " 🔐  AES-NI              : $AES_NI"
    echo -e " 📦  VM-x/AMD-V          : $VM_X"
    echo -e " 💾  Всего диска         : ${YELLOW}$D_TOTAL ($D_USED использовано)${NC}"
    echo -e " 🐏  Всего памяти        : ${YELLOW}$RAM_TOTAL GB ($(printf "%.1f" $MEM_USED) GB использовано)${NC}"
    echo -e " ⏱️   Время работы        : ${YELLOW}$UPTIME${NC}"
    echo -e " 📈  Средняя нагрузка    : ${YELLOW}$LOAD_AVG${NC}"
    echo -e " 🐧  ОС                  : ${YELLOW}$OS_NAME${NC}"
    echo -e " 🏗️   Архитектура         : ${YELLOW}$ARCH (64 Bit)${NC}"
    echo -e " ⚙️   Ядро                : ${YELLOW}$KERNEL${NC}"
    echo -e " 🚀  TCP CC              : ${YELLOW}$TCP_CC${NC}"
    echo -e " ☁️   Виртуализация       : ${YELLOW}$VIRT${NC}"
    echo -e " 🌐  IPv4 / IPv6         : ${GREEN}$IPV4${NC} / ${GREEN}${IPV6}${NC}"
    echo -e " 🌍  Страна              : ${YELLOW}$COUNTRY${NC}"
    echo -e " 🏢  Организация         : ${YELLOW}$ORG${NC}"
    echo -e " 📍  Локация             : ${YELLOW}$LOC${NC}"
    echo -e " 🗺️   Регион              : ${YELLOW}$REG${NC}"
    echo -e "${BLUE}----------------------------------------------------------------------${NC}"
    
    # СТАТУС ПРИЛОЖЕНИЙ
    echo -e "${BLUE}--- СТАТУС ПРИЛОЖЕНИЙ --------------------------------${NC}"
    # Проверка X-UI. Отсутствие каталога и остановленная служба — разные вещи:
    # на чистом сервере «ОСТАНОВЛЕН» отправлял пользователя запускать службу
    # вместо установки. Признак установки тот же, что у telemt ниже, — свой
    # каталог конфигурации.
    if [ ! -d /etc/x-ui ]; then
        status_xui="${RED}НЕ УСТАНОВЛЕН${NC}"
    elif systemctl is-active --quiet x-ui; then
        status_xui="${GREEN}РАБОТАЕТ${NC}"
    else
        status_xui="${RED}ОСТАНОВЛЕН${NC}"
    fi

    # Проверка telemt (MTProto-прокси)
    if [ ! -f /etc/telemt/telemt.toml ]; then
        status_telemt="${RED}НЕ УСТАНОВЛЕН${NC}"
    elif systemctl is-active --quiet telemt; then
        status_telemt="${GREEN}РАБОТАЕТ${NC}"
    else
        status_telemt="${RED}ОСТАНОВЛЕН${NC}"
    fi

    # Проверка Telegram-ботов. Наличие юнита — признак установки; режимов три,
    # и одновременно работает либо объединённый бот, либо отдельные.
    bots_up=0; bots_total=0
    for unit in 3xui-telemt-bot telemt-bot 3xui-monitor; do
        [ -f "/etc/systemd/system/$unit.service" ] || continue
        bots_total=$((bots_total + 1))
        systemctl is-active --quiet "$unit" && bots_up=$((bots_up + 1))
    done
    if [ "$bots_total" -eq 0 ]; then
        status_bots="${RED}НЕ УСТАНОВЛЕНЫ${NC}"
    elif [ "$bots_up" -eq "$bots_total" ]; then
        if [ -f /etc/systemd/system/3xui-telemt-bot.service ]; then
            status_bots="${GREEN}РАБОТАЕТ (объединённый)${NC}"
        else
            status_bots="${GREEN}РАБОТАЮТ ($bots_up/$bots_total)${NC}"
        fi
    else
        status_bots="${RED}ЧАСТИЧНО ($bots_up/$bots_total)${NC}"
    fi

    echo -e "    🎛️   X-UI:        [$status_xui]"
    echo -e "    ✈️   telemt:      [$status_telemt]"
    echo -e "    🤖  TG-боты:     [$status_bots]"

    # АДРЕСА. Здесь намеренно НЕТ паролей и секрета telemt: это меню
    # открывается при каждом входе по SSH, а его скриншот лежит в публичном
    # README. Решение подтверждено отдельно: учётки показываются полностью, но
    # в подменю — X-UI для панели 3x-ui, «Стек telemt» для telemt_panel.
    #
    # Блок целиком пропускается, если показывать нечего — на чистом сервере он
    # не должен занимать экран пустыми строками. Условие смотрит ровно на те
    # значения, которые печатаются: иначе на сервере с конфигом стека, но без
    # собираемых адресов рисовался бы заголовок с одной подсказкой.
    local addr_panel addr_tp tg_login
    addr_panel=$(xui_panel_url)
    addr_tp=$(telemt_panel_url)
    tg_login=""
    if [ -f /etc/vsm/telemt.conf ]; then
        # Значение из конфига уходит в echo -e, поэтому чистим его так же, как
        # адреса — от управляющих символов.
        tg_login=$(_addr_clean "$(grep -m1 -oP '^PANEL_ADMIN_USER=\K.*' /etc/vsm/telemt.conf 2>/dev/null | tr -d "\"'")")
    fi
    if [ -n "$addr_panel" ] || [ -n "$addr_tp" ]; then
        echo -e "${BLUE}--- АДРЕСА -------------------------------------------${NC}"
        [ -n "$addr_panel" ] && echo -e "    Панель 3x-ui:   ${CYAN}${addr_panel}${NC}"
        [ -n "$addr_tp" ] && \
            echo -e "    telemt_panel:   ${CYAN}${addr_tp}${NC}${tg_login:+   логин: ${YELLOW}${tg_login}${NC}}"
        echo -e "    ${BLUE}Логины и пароли — в подменю «Управление X-UI» и «Стек telemt»${NC}"
    fi

    echo -e "${BLUE}--- ДЕЙСТВИЯ ---------------------------------------${NC}"
    echo -e "${YELLOW}1) 🎛️   Управление X-UI (установка | запуск | статус)${NC}"
    # Подпись описывает действия, а не механизмы: скриншот главного меню
    # попадает в публичный README, а «self-SNI» и «SYN-лимитер» — ровно то,
    # что из текста README было убрано.
    echo -e "${YELLOW}2) ✈️   Стек telemt / MTProto (установка | панель | диагностика)${NC}"
    echo -e "${YELLOW}3) 🤖  Telegram-боты (Telemt | панели 3x-ui)${NC}"
    echo -e "${GREEN}4) 🧪  Тестирование сервера (скорость | блокировки | сканеры)${NC}"
    echo -e "${GREEN}5) ⚙️   Настройка и оптимизация (BBR | UFW | SSL | WARP)${NC}"
    echo -e "${GREEN}6) 🌐  Меню IPv6 (включить | выключить | статус)${NC}"
    echo -e "${YELLOW}7) 🛠️   Системные утилиты (htop | ncdu | сеть | очистка)${NC}"
    echo -e "${CYAN}8) 🔄  Обновить скрипты (с GitHub)${NC}"
    echo -e "${RED}X) 🚪  Выход в оболочку${NC}"
    echo -e "${BLUE}------------------------------------------------------${NC}"
}

# Проверка обновлений — один раз за сессию, до входа в цикл. Раньше вызов
# стоял внутри while и дёргал git fetch к GitHub после каждого действия в
# меню: лишний сетевой запрос и повторный показ уведомления.
check_for_updates

# ГЛАВНЫЙ ЦИКЛ ЗАПУСКА - вызывает внешние скрипты
while true; do
    show_menu
    PROMPT=$(echo -e "${CYAN}Ваш выбор: ${NC}")
    read -p "$PROMPT" choice

    case $choice in
        1) /usr/local/bin/menu_xui.sh ;;
        2) /usr/local/bin/menu_telemt.sh ;;
        3) /usr/local/bin/menu_bots.sh ;;
        4) /usr/local/bin/menu_tests.sh ;;
        5) /usr/local/bin/menu_setup.sh ;;
        6) /usr/local/bin/ipv6-menu ;;
        7) /usr/local/bin/menu_utils.sh ;;
        8)
           echo -e "${YELLOW}>>> Принудительное обновление через Git...${NC}"
           cd "$VSM_DIR" || exit
           git fetch origin main &>/dev/null
           if git reset --hard origin/main > /dev/null; then
               chmod +x "$VSM_DIR"/*.sh "$VSM_DIR/vsm" "$VSM_DIR/ipv6-menu" 2>/dev/null
			   for file in "$VSM_DIR"/*.sh "$VSM_DIR/vsm" "$VSM_DIR/ipv6-menu"; do
			       [ -f "$file" ] || continue
			       case "$(basename "$file")" in install.sh|uninstall.sh) continue ;; esac
			       ln -sf "$file" "/usr/local/bin/$(basename "$file")"
			   done
			   # Убираем ссылки на упразднённые модули (Hysteria2, MTProxy)
			   rm -f /usr/local/bin/menu_hysteria.sh /usr/local/bin/menu_mtproxy.sh
			   # Код ботов лежит в этом же репозитории: без перезапуска службы
			   # продолжили бы работать на старой версии.
			   for unit in 3xui-telemt-bot telemt-bot 3xui-monitor; do
			       [ -f "/etc/systemd/system/$unit.service" ] || continue
			       echo -e "${YELLOW}>>> Перезапускаю $unit...${NC}"
			       systemctl restart "$unit" 2>/dev/null
			   done
               echo -e "${GREEN}✅ Обновлено! Перезапуск...${NC}"
               sleep 1
               exec bash "$0"
           else
               echo -e "${RED}❌ Ошибка обновления.${NC}"
               read -p "Нажмите Enter..."
           fi
           ;;
        [Xx])                                   
            echo -e "${GREEN}Выход в оболочку.${NC}"
            break
            ;;
        *)
            echo -e "${RED}❌ Неверный ввод.${NC}"
            sleep 1
            ;;
    esac
done
