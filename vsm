#!/bin/bash

# ======================================================================
# ГЛАВНЫЙ ФАЙЛ МЕНЮ
# ======================================================================

# Подключаем все общие переменные и функции
source /usr/local/bin/_config_and_utils.sh

# Каталог репозитория вычисляется от самого скрипта, а не задан жёстко.
# При запуске через симлинк /usr/local/bin/vsm readlink -f приводит к
# реальному файлу внутри репозитория.
#
# Иначе установка под прежним именем (/root/VPS-main-menu), обновившись до
# версии с жёстким /root/VSM, теряла бы свой каталог: проверка обновлений
# молча выключалась, а пункт обновления просто выходил из меню — починить
# изнутри было уже нельзя.
VSM_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

function check_for_updates {
    # Переходим в физическую папку репозитория, чтобы Git видел .git
    cd "$VSM_DIR" || return
    
    # Проверяем наличие .git
    [ ! -d .git ] && return

    # Запрашиваем инфо с GitHub
    git fetch origin main &>/dev/null
    
    # Считаем именно отставание, а не любое расхождение: при сравнении
    # хешей уведомление всплывало и когда локальные коммиты просто не
    # отправлены — со списком из нуля пунктов.
    local total
    total=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)

    if [ "$total" -gt 0 ]; then
        echo -e "${YELLOW}======================================================"
        echo -e "📢  ${GREEN}ДОСТУПНО ОБНОВЛЕНИЕ${NC} ${CYAN}(коммитов: $total)${NC}"
        echo -e "${YELLOW}------------------------------------------------------"
        # Только заголовки и не больше пяти. Раньше выводилось «%s%n %b» —
        # вместе с телом коммита. На пяти коммитах это 149 строк, экран
        # улетал вверх, а при автозапуске меню пользоваться сервером было
        # нельзя, пока не пролистаешь всё.
        # Обрезка через sed, а не cut -c: cut считает байты, и кириллица
        # рвалась посреди символа, оставляя в выводе «конв<?>».
        git log HEAD..origin/main --max-count=5 --pretty=format:'%s' 2>/dev/null \
            | sed -e 's/\(.\{58\}\).*/\1…/' -e 's/^/  • /'
        echo ""
        if [ "$total" -gt 5 ]; then
            echo -e "  ${CYAN}… и ещё $((total - 5)); полный список — git log в каталоге VSM${NC}"
        fi
        echo -e "${YELLOW}------------------------------------------------------"
        echo -e "Нажмите ${GREEN}[8]${NC} в меню для автообновления."
        echo -e "======================================================${NC}"
        # Пауза, чтобы уведомление не стёрлось командой clear. С таймаутом:
        # при автозапуске на каждом входе по SSH бессрочное ожидание
        # блокировало бы работу с сервером.
        read -t 15 -p "Enter или 15 сек до продолжения..." || true
        echo ""
    fi
}

# --- ГЛАВНОЕ МЕНЮ ---
# ----------------------------------------------------------------------
# Пункт 0 — доступы и домены.
#
# Всё это раньше жило на главном экране блоком АДРЕСА и уехало сюда целиком.
# Причина не в тесноте: полный адрес панели содержит случайный webBasePath,
# который и есть механизм защиты от сканирования, а главное меню открывается
# при каждом входе по SSH, и его скриншот лежит в публичном README. Инвариант
# 6 требует ровно этого — показывать полностью, но в подменю.
#
# Пароли скрыты до нажатия P и печатаются один раз. Ревью отмечало отдельным
# пунктом, что пароль, перерисовываемый в цикле меню, множится в истории
# терминала; разовый показ по запросу это снимает.
# ----------------------------------------------------------------------

# Выравнивание, ширина терминала и примитивы отрисовки живут в
# _config_and_utils.sh: подменю нужны те же самые, а копия — это две копии,
# которые однажды разойдутся.

# Значение из файла конфигурации. Кавычки снимаются разворачиванием параметра,
# а не через tr: в конфиг они попадают из printf %q при записи, а вложенные
# кавычки внутри команды — источник ошибок, которые видны только в рантайме.
# Результат идёт в echo -e, поэтому проходит через _addr_clean.
function _cfg_val {
    local file="$1" key="$2" v
    [ -f "$file" ] || return 0
    v=$(grep -m1 -oP "^${key}=\K.*" "$file" 2>/dev/null) || v=""
    v=${v%\"}; v=${v#\"}
    v=${v%\'}; v=${v#\'}
    _addr_clean "$v"
}

function show_access_info {
    local reveal=0
    while true; do
        clear
        ui_title "🔑  ДОСТУПЫ И ДОМЕНЫ"

        local url_xui url_tp
        url_xui=$(xui_panel_url)
        url_tp=$(telemt_panel_url)

        echo ""
        ui_section "ПАНЕЛЬ 3X-UI"
        if [ -n "$url_xui" ]; then
            ui_kv '🌐  Адрес' "$url_xui" 17
        else
            echo -e "   ${C_NAME}$(ui_pad '🌐  Адрес' 17)${NC}${C_WARN}панель не установлена${NC}"
        fi
        # Пароль панели прочитать с сервера нельзя: установщик печатает его
        # один раз и не сохраняет, панель держит bcrypt-хэш. /etc/vsm/xui.conf
        # — записная книжка, заполняется вручную пунктом «Учётные данные».
        local xu xp
        xu=$(xui_admin_user); xp=$(xui_admin_pass)
        if [ -n "$xu" ] || [ -n "$xp" ]; then
            ui_secret '👤  Логин' "${xu:-—}" 17
            if [ "$reveal" -eq 1 ]; then
                # printf, а не echo -e: пароль приходит аргументом и его
                # содержимое не разворачивается. Цвет берётся из палитры через
                # %b, а не вписывается байтами ESC в формат — иначе он проходит
                # мимо NO_COLOR и мимо снятия цвета без терминала.
                printf "   %b%s%b%b%s%b\n" "$C_NAME" "$(ui_pad '🔑  Пароль' 17)" "$NC" \
                    "$C_SECRET" "$xp" "$NC"
            else
                ui_kv '🔑  Пароль' 'скрыт, показать — P' 17
            fi
        else
            ui_kv '🔑  Учётные данные' 'не записаны — пункт «Панель X-UI»' 20
        fi

        echo ""
        ui_section "ПАНЕЛЬ TELEMT_PANEL"
        if [ -n "$url_tp" ]; then
            ui_kv '🌐  Адрес' "$url_tp" 17
        else
            echo -e "   ${C_NAME}$(ui_pad '🌐  Адрес' 17)${NC}${C_WARN}стек telemt не установлен${NC}"
        fi
        local tu tpass
        tu=$(_cfg_val /etc/vsm/telemt.conf PANEL_ADMIN_USER)
        tpass=$(_cfg_val /etc/vsm/telemt.conf PANEL_ADMIN_PASS)
        if [ -n "$tu" ]; then
            ui_secret '👤  Логин' "$tu" 17
            if [ "$reveal" -eq 1 ]; then
                printf "   %b%s%b%b%s%b\n" "$C_NAME" "$(ui_pad '🔑  Пароль' 17)" "$NC" \
                    "$C_SECRET" "$tpass" "$NC"
            else
                ui_kv '🔑  Пароль' 'скрыт, показать — P' 17
            fi
        fi

        if [ -f /etc/vsm/awg.conf ]; then
            local awg_port awg_profile
            awg_port=$(_cfg_val /etc/vsm/awg.conf AWG_PORT)
            awg_profile=$(_cfg_val /etc/vsm/awg.conf AWG_PROFILE)
            echo ""
            ui_section "AMNEZIAWG"
            echo -e "   ${C_NAME}$(ui_pad '🔐  Порт' 17)${NC}${C_DESC}$(ui_pad "${awg_port}/udp" 20)${NC}${C_NAME}$(ui_pad '🎭  Профиль' 17)${NC}${C_DESC}${awg_profile}${NC}"
        fi

        local d_panel d_reality
        d_panel=$(_cfg_val /etc/vsm/telemt.conf DOMAIN_PANEL)
        d_reality=$(_cfg_val /etc/vsm/telemt.conf DOMAIN_REALITY)
        if [ -n "$d_panel" ] || [ -n "$d_reality" ]; then
            echo ""
            ui_section "ДОМЕНЫ"
            if [ -n "$d_panel" ]; then
                echo -e "   🎯  ${C_NAME}$(ui_pad "$d_panel" 34)${NC}${C_DESC}панель 3x-ui, она же цель self-SNI${NC}"
            fi
            if [ -n "$d_reality" ]; then
                echo -e "   🛡  ${C_NAME}$(ui_pad "$d_reality" 34)${NC}${C_DESC}SNI-роутинг REALITY${NC}"
            fi
        fi

        echo ""
        ui_hr
        if [ "$reveal" -eq 1 ]; then
            ui_item "P" "🙈" "Скрыть пароли"
        else
            ui_item "P" "👁" "Показать пароли"
        fi
        ui_item "X" "🔙" "Назад"
        echo ""

        # "|| break" обязателен: при закрытом stdin read возвращается мгновенно
        # и пустым, и цикл занял бы ядро целиком.
        read -p "Ваш выбор [P, X]: " ch || break
        case "$ch" in
            [Pp]) if [ "$reveal" -eq 1 ]; then reveal=0; else reveal=1; fi ;;
            *) break ;;
        esac
    done
    # Экран чистим на выходе: пароль, показанный открытым текстом, не должен
    # оставаться после возврата в главное меню.
    clear
}

function show_menu {
    clear
    # Через ui_title, а не литералом: рамка считается от терминала, и здесь же
    # сбрасывается кэш ширины — то есть смена размера окна подхватывается раз
    # на отрисовку, а не двадцатью форками tput подряд.
    ui_title "VPS SERVER MENU (VSM)"


    # --- БЛОК ОТОБРАЖЕНИЯ ХАРАКТЕРИСТИК ---
    # --- СБОР ДАННЫХ В СТИЛЕ BENCH.SH ---
    # CPU
    if command -v lscpu &> /dev/null; then
        CPU_MODEL=$(lscpu 2>/dev/null | grep 'Model name:' | head -n 1 | awk -F ':' '{print $2}' | sed -e 's/^[ \t]*//')
        CPU_CORES=$(nproc)
        CPU_FREQ=$(lscpu | grep -i "CPU MHz" | awk -F': ' '{print $2}' | xargs)
		if [ -z "$CPU_FREQ" ]; then
    CPU_FREQ=$(grep -m1 "cpu MHz" /proc/cpuinfo | awk -F': ' '{print $2}' | xargs)
fi
        CPU_CACHE=$(lscpu | grep "L3 cache" | awk '{print $3$4}')
    else
        CPU_MODEL="Не определено"; CPU_CORES="?"; CPU_FREQ="?"; CPU_CACHE="?"
    fi

    # AES-NI / Virtualization
    # Текст и цвет храним раздельно: ANSI-коды внутри значения ui_pad считает
    # символами, и колонка справа съезжает ровно на их длину.
    if grep -qw aes /proc/cpuinfo; then AES_NI="✓ Включено"; AES_C="$GREEN"; else AES_NI="✗ Выключено"; AES_C="$RED"; fi
    if grep -Eowq "vmx|svm" /proc/cpuinfo; then VM_X="✓ Включено"; VM_C="$GREEN"; else VM_X="✗ Выключено"; VM_C="$RED"; fi
    VIRT=$(systemd-detect-virt 2>/dev/null || echo "Unknown")

    # DISK & MEM
    RAM_TOTAL_RAW=$(grep MemTotal /proc/meminfo | awk '{print $2/1024/1024}')
    RAM_TOTAL=$(printf "%.1f" $RAM_TOTAL_RAW)
    MEM_FREE=$(grep MemAvailable /proc/meminfo | awk '{print $2/1024/1024}')
    MEM_USED=$(echo "$RAM_TOTAL - $MEM_FREE" | bc -l)
    
    DISK_USAGE=$(df -h --output=size,used / | tail -n 1)
    read -r D_TOTAL D_USED <<< "$DISK_USAGE"

    # SYSTEM INFO
    UPTIME_RAW=$(uptime -p | sed 's/up //')
    UPTIME=$(echo "$UPTIME_RAW" | sed -e 's/years\?/лет/g' -e 's/weeks\?/недель/g' -e 's/days\?/дн./g' -e 's/hours\?/час./g' -e 's/minutes\?/мин./g')
    LOAD_AVG=$(awk '{print $1", "$2", "$3}' /proc/loadavg)
    OS_NAME=$(grep "PRETTY_NAME" /etc/os-release | cut -d'"' -f2)
    ARCH=$(uname -m)
    # Разрядность отдельно от архитектуры: x86_64 и aarch64 говорят о наборе
    # команд, а не о разрядности userspace — на 32-битном образе поверх
    # 64-битного ядра uname -m всё равно скажет x86_64.
    ARCH_BITS=$(getconf LONG_BIT 2>/dev/null) || ARCH_BITS=""
    KERNEL=$(uname -r)
    TCP_CC=$(sysctl net.ipv4.tcp_congestion_control | awk '{print $3}')

    # NETWORK & GEO
    #
    # Таймауты обязательны, и по той же причине, что у timeout 2 в
    # xui_panel_url: это меню открывается из ~/.bashrc при КАЖДОМ входе по SSH,
    # уже после clear. Без --max-time curl ждёт по умолчанию до 300 с на
    # подключение, и при заблокированном ipinfo.io администратор получал пустой
    # экран на минуты — дважды подряд, потому что запроса два. Заблокированный
    # ipinfo.io — не гипотеза, а ровно тот случай, ради которого ставят VSM.
    #
    # У ipinfo.io схема указана явно: без неё curl идёт по http. У ip-api.com
    # ниже оставлен http сознательно — SSL там только в платном тарифе, и
    # https молча вернул бы пустоту. Раз ответ приходит открытым текстом и
    # правится кем угодно на пути, а печатается через echo -e, который
    # разворачивает escape-последовательности в терминале root, — все значения
    # оттуда обязаны пройти через _addr_clean. См. ниже.
    IPV4=$(curl -s4 --connect-timeout 2 --max-time 4 https://ipinfo.io/ip 2>/dev/null)
    # Значение уходит и в URL, и в вывод — оставляем только то, что похоже на
    # адрес. Раньше при неудаче сюда попадала строка «✗ Offline» ВМЕСТЕ с
    # ANSI-кодами и подставлялась в URL следующего запроса.
    printf '%s' "$IPV4" | grep -qE '^[0-9a-fA-F.:]+$' || IPV4=""
    IPV6=$(get_public_ipv6)
    GEO_DATA=""
    [ -n "$IPV4" ] && GEO_DATA=$(curl -s --connect-timeout 2 --max-time 4 \
        "http://ip-api.com/json/$IPV4?lang=ru&fields=status,message,country,regionName,city,isp,org,as" 2>/dev/null)
    COUNTRY=$(echo "$GEO_DATA" | jq -r '.country' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"country":"\K[^"]+')
    LOC=$(echo "$GEO_DATA" | jq -r '.city' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"city":"\K[^"]+')
    REG=$(echo "$GEO_DATA" | jq -r '.regionName' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"regionName":"\K[^"]+')
    ORG=$(echo "$GEO_DATA" | jq -r '.org' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"org":"\K[^"]+')
    if [ -z "$ORG" ] || [ "$ORG" == "null" ]; then
        ORG=$(echo "$GEO_DATA" | jq -r '.isp' 2>/dev/null || echo "$GEO_DATA" | grep -oP '"isp":"\K[^"]+')
    fi
    # Всё, что пришло из сети, чистим перед echo -e — как домены и учётки.
    # Значение подконтрольно тому, кто сидит на пути открытого HTTP, а строка
    # печатается при каждом входе по SSH: без чистки туда кладут ESC-коды и
    # перерисовывают экран, вплоть до поддельного приглашения ввода пароля.
    # Длину ограничиваем, чтобы длинный ORG не разъезжал таблицу.
    COUNTRY=$(_addr_clean "$COUNTRY" | cut -c1-48)
    LOC=$(_addr_clean "$LOC" | cut -c1-48)
    REG=$(_addr_clean "$REG" | cut -c1-48)
    ORG=$(_addr_clean "$ORG" | cut -c1-64)
    # Пустой IPv4 — это «не дозвонились», и так и печатаем. Раньше строка с
    # ANSI-кодами лежала в самой переменной и уезжала в URL запроса.
    [ -n "$IPV4" ] || IPV4="${RED}✗ Offline${NC}"
    # --- ВЫВОД МЕНЮ В СТИЛЕ BENCH.SH ---
    # Характеристики сервера в две колонки.
    #
    # Прежний вид — двадцать строк по одному значению — отодвигал пункты меню
    # за нижний край экрана, а меню открывается из ~/.bashrc при КАЖДОМ входе
    # по SSH. Сжатая до двух строк сводка оказалась недостаточной: нужны и
    # модель процессора, и AES-NI, и виртуализация, и организация. Две
    # колонки дают полный состав вдвое короче.
    #
    # Выравнивание через ui_pad, а НЕ через printf %-13s: printf считает байты,
    # а кириллица в UTF-8 занимает два байта на букву, и колонки разъезжались
    # ровно на длину русской подписи. ${#s} в bash считает символы.
    # Две ячейки в строке, у каждой свой значок.
    #
    # Значок в выравнивание не входит — его ширина в ячейках зависит от
    # терминала. Колонки отсчитываются от подписи, поэтому съехать может только
    # сам значок, но не таблица за ним. Ширины: подпись 14, значение 21, вторая
    # подпись 14 — в сумме с отступами ровно 78, как у разделителей.
    #
    # Строки, где значение длинное (модель процессора, IPv6, организация),
    # занимают всю ширину: пара для них не влезает, а обрезать модель, как было
    # раньше, значит показывать «Intel(R) Xeon(R) Platinum 81» вместо ответа на
    # вопрос, ради которого её и смотрят.
    # На узком терминале пара печатается двумя строками. Иначе вторая половина
    # переносится посередине значения, и таблица превращается в кашу — меню
    # открывается при каждом входе, в том числе с телефона.
    _row2() { # подпись1 значение1 цвет1 подпись2 значение2 цвет2
        if ui_narrow; then
            echo -e "   ${3}$(ui_pad "$1" 17)${NC}${C_DESC}${2}${NC}"
            echo -e "   ${6}$(ui_pad "$4" 17)${NC}${C_DESC}${5}${NC}"
            return
        fi
        echo -e "   ${3}$(ui_pad "$1" 17)${NC}${C_DESC}$(ui_pad "$2" 20)${NC}${6}$(ui_pad "$4" 17)${NC}${C_DESC}${5}${NC}"
    }
    _row1() { # подпись значение
        echo -e "   ${C_NAME}$(ui_pad "$1" 17)${NC}${C_DESC}${2}${NC}"
    }

    echo ""
    ui_section "СЕРВЕР"
    _row1 "💻  Процессор"   "$CPU_MODEL"
    _row2 "🧠  Ядра"        "${CPU_CORES} @ ${CPU_FREQ} MHz"                        "$C_NAME" \
          "💽  Кэш L3"      "$CPU_CACHE"                                            "$C_NAME"
    _row2 "🐏  Память"      "${RAM_TOTAL} ГБ (занято $(printf '%.1f' "$MEM_USED"))" "$C_NAME" \
          "💾  Диск"        "${D_TOTAL} (занято ${D_USED})"                         "$C_NAME"
    _row2 "📈  Нагрузка"    "$LOAD_AVG"                                             "$C_NAME" \
          "⏳  Аптайм"      "$UPTIME"                                               "$C_NAME"
    _row2 "🐧  ОС"          "${OS_NAME:0:20}"                                       "$C_NAME" \
          "🧱  Архитектура" "${ARCH}${ARCH_BITS:+ (${ARCH_BITS} бит)}"              "$C_NAME"
    _row2 "🔩  Ядро"        "$KERNEL"                                               "$C_NAME" \
          "🚀  TCP CC"      "$TCP_CC"                                               "$C_NAME"
    # AES-NI и VM-x красятся по состоянию: это не значение, а признак «есть или
    # нет», и цвет здесь несёт смысл, а не роль.
    echo -e "   ${C_NAME}$(ui_pad '📦  Виртуализация' 17)${NC}${C_DESC}$(ui_pad "$VIRT" 20)${NC}${C_NAME}$(ui_pad '🔒  AES-NI' 17)${NC}${AES_C}${AES_NI}${NC}"
    echo -e "   ${C_NAME}$(ui_pad '🧩  VM-x/AMD-V' 17)${NC}${VM_C}$(ui_pad "$VM_X" 20)${NC}${C_NAME}$(ui_pad '🌐  IPv4' 17)${NC}${C_DESC}${IPV4:-—}${NC}"
    if [ -n "$IPV6" ]; then
        _row1 "🌐  IPv6" "$IPV6"
    fi
    # Гео приходит открытым текстом от стороннего API. Печатаем через printf
    # %s, а не echo -e: подмена ответа на пути не должна разворачивать
    # управляющие последовательности в терминале root.
    # Цвет берём из палитры и разворачиваем через %b, а не вписываем байтами
    # ESC в строку формата, как было раньше. Вписанные байты проходили мимо
    # NO_COLOR и мимо снятия цвета без терминала: в прогоне без TTY эти две
    # строки оставались единственными крашеными, и коды лезли в вывод текстом.
    # Данные по-прежнему идут через %s и не интерпретируются.
    if [ -n "$COUNTRY" ]; then
        printf "   %b%s%b%b%s%b%b%s%b%b%s%b\n" \
            "$C_NAME" "$(ui_pad '🌍  Страна' 17)" "$NC" \
            "$C_DESC" "$(ui_pad "$COUNTRY" 20)" "$NC" \
            "$C_NAME" "$(ui_pad '📍  Локация' 17)" "$NC" \
            "$C_DESC" "$LOC" "$NC"
    fi
    if [ -n "$REG" ] && [ "$REG" != "null" ]; then
        printf "   %b%s%b%b%s%b\n" \
            "$C_NAME" "$(ui_pad '🧭  Регион' 17)" "$NC" "$C_DESC" "$REG" "$NC"
    fi
    if [ -n "$ORG" ]; then
        printf "   %b%s%b%b%s%b\n" \
            "$C_NAME" "$(ui_pad '🏢  Организация' 17)" "$NC" "$C_DESC" "$ORG" "$NC"
    fi

    # СТАТУС ПРИЛОЖЕНИЙ
    echo ""
    echo -e "${BLUE}  ── СТАТУС ─────────────────────────────────────────────────────────────────${NC}"
    # Проверка X-UI. Отсутствие каталога и остановленная служба — разные вещи:
    # на чистом сервере «ОСТАНОВЛЕН» отправлял пользователя запускать службу
    # вместо установки. Признак установки тот же, что у telemt ниже, — свой
    # каталог конфигурации.
    #
    # Текст и цвет храним РАЗДЕЛЬНО. Сцепленная строка не выравнивается: ui_pad
    # считает символы, а escape-коды внутри значения он посчитал бы за них же —
    # ту же ошибку проект уже ловил на AES-NI в шапке. Раздельно колонка
    # отсчитывается по видимому тексту, а цвет приклеивается снаружи.
    if [ ! -d /etc/x-ui ]; then
        st_xui="НЕ УСТАНОВЛЕН"; c_xui="$C_DANGER"
    elif systemctl is-active --quiet x-ui; then
        st_xui="РАБОТАЕТ"; c_xui="$C_OK"
    else
        st_xui="ОСТАНОВЛЕН"; c_xui="$C_DANGER"
    fi

    # Проверка telemt (MTProto-прокси)
    if [ ! -f /etc/telemt/telemt.toml ]; then
        st_telemt="НЕ УСТАНОВЛЕН"; c_telemt="$C_DANGER"
    elif systemctl is-active --quiet telemt; then
        st_telemt="РАБОТАЕТ"; c_telemt="$C_OK"
    else
        st_telemt="ОСТАНОВЛЕН"; c_telemt="$C_DANGER"
    fi

    # Проверка Telegram-ботов. Наличие юнита — признак установки; режимов три,
    # и одновременно работает либо объединённый бот, либо отдельные.
    bots_up=0; bots_total=0
    for unit in 3xui-telemt-bot telemt-bot 3xui-monitor; do
        [ -f "/etc/systemd/system/$unit.service" ] || continue
        bots_total=$((bots_total + 1))
        systemctl is-active --quiet "$unit" && bots_up=$((bots_up + 1))
    done
    if [ "$bots_total" -eq 0 ]; then
        st_bots="НЕ УСТАНОВЛЕНЫ"; c_bots="$C_DANGER"
    elif [ "$bots_up" -eq "$bots_total" ]; then
        c_bots="$C_OK"
        if [ -f /etc/systemd/system/3xui-telemt-bot.service ]; then
            st_bots="РАБОТАЕТ (объединённый)"
        else
            st_bots="РАБОТАЮТ ($bots_up/$bots_total)"
        fi
    else
        st_bots="ЧАСТИЧНО ($bots_up/$bots_total)"; c_bots="$C_DANGER"
    fi

    # AmneziaWG. Признак установки — свой конфиг, как у x-ui и telemt: без
    # него «ОСТАНОВЛЕН» на чистом сервере отправлял бы запускать то, чего нет.
    # Смотрим на контейнер, а не на службу systemd: узел живёт в Docker.
    if [ ! -f /etc/vsm/awg.conf ]; then
        st_awg="НЕ УСТАНОВЛЕН"; c_awg="$C_DANGER"
    elif [ "$(docker inspect -f '{{.State.Running}}' awg-server 2>/dev/null)" = "true" ]; then
        st_awg="РАБОТАЕТ"; c_awg="$C_OK"
    else
        st_awg="ОСТАНОВЛЕН"; c_awg="$C_DANGER"
    fi

    # Две пары в строке. Первая колонка выравнивается по видимому тексту
    # статуса, поэтому вторая всегда начинается на своём месте — раньше она
    # ездила вслед за длиной «РАБОТАЕТ» или «НЕ УСТАНОВЛЕН».
    echo -e "   📊  ${C_NAME}$(ui_pad 'X-UI' 11)${NC}${c_xui}$(ui_pad "$st_xui" 24)${NC}🔐  ${C_NAME}$(ui_pad 'AmneziaWG' 11)${NC}${c_awg}${st_awg}${NC}"
    echo -e "   🛫  ${C_NAME}$(ui_pad 'telemt' 11)${NC}${c_telemt}$(ui_pad "$st_telemt" 24)${NC}🤖  ${C_NAME}$(ui_pad 'TG-боты' 11)${NC}${c_bots}${st_bots}${NC}"

    echo ""
    ui_section "СПРАВКА"
    ui_item "0" "🔑" "Доступы и домены" "Адреса панелей, учётные данные, домены"
    echo ""
    ui_section "СЕРВИСЫ"
    ui_item "1" "📊" "Панель X-UI"     "3x-ui-pro: VLESS, Reality, Trojan, SSL"
    ui_item "2" "🔐" "AmneziaWG"       "Обфусцированный WireGuard, свой UDP-порт"
    ui_item "3" "🛫" "Стек telemt"     "MTProto-прокси, веб-панель, маскировка"
    ui_item "4" "🤖" "Telegram-боты"   "Мониторинг telemt и панелей 3x-ui"
    echo ""
    ui_section "ОБСЛУЖИВАНИЕ"
    ui_item "5" "🧪" "Тестирование"      "Доступность из РФ, скорость, сканеры"
    ui_item "6" "🔧" "Настройка системы" "BBR, ICMP, UFW, время, SSL, WARP, IPv6"
    ui_item "7" "🧰" "Системные утилиты" "htop, ncdu, порты, очистка, диагностика"
    ui_item "8" "🔄" "Обновить VSM"      "git pull, пересоздание ссылок, рестарт"
    echo ""
    ui_item "X" "🚪" "Выход"
    echo ""
}

# Проверка обновлений — один раз за сессию, до входа в цикл. Раньше вызов
# стоял внутри while и дёргал git fetch к GitHub после каждого действия в
# меню: лишний сетевой запрос и повторный показ уведомления.
check_for_updates

# ГЛАВНЫЙ ЦИКЛ ЗАПУСКА - вызывает внешние скрипты
while true; do
    show_menu
    PROMPT=$(echo -e "${CYAN}Ваш выбор: ${NC}")
    read -p "$PROMPT" choice

    case $choice in
        0) show_access_info ;;
        1) /usr/local/bin/menu_xui.sh ;;
        2) /usr/local/bin/menu_awg.sh ;;
        3) /usr/local/bin/menu_telemt.sh ;;
        4) /usr/local/bin/menu_bots.sh ;;
        5) /usr/local/bin/menu_tests.sh ;;
        6) /usr/local/bin/menu_setup.sh ;;
        7) /usr/local/bin/menu_utils.sh ;;
        8)
           echo -e "${YELLOW}>>> Принудительное обновление через Git...${NC}"
           cd "$VSM_DIR" || exit
           git fetch origin main &>/dev/null
           if git reset --hard origin/main > /dev/null; then
               chmod +x "$VSM_DIR"/*.sh "$VSM_DIR/vsm" "$VSM_DIR/ipv6-menu" 2>/dev/null
			   for file in "$VSM_DIR"/*.sh "$VSM_DIR/vsm" "$VSM_DIR/ipv6-menu"; do
			       [ -f "$file" ] || continue
			       case "$(basename "$file")" in install.sh|uninstall.sh) continue ;; esac
			       ln -sf "$file" "/usr/local/bin/$(basename "$file")"
			   done
			   # Убираем ссылки на упразднённые модули (Hysteria2, MTProxy)
			   rm -f /usr/local/bin/menu_hysteria.sh /usr/local/bin/menu_mtproxy.sh
			   # Код ботов лежит в этом же репозитории: без перезапуска службы
			   # продолжили бы работать на старой версии.
			   for unit in 3xui-telemt-bot telemt-bot 3xui-monitor; do
			       [ -f "/etc/systemd/system/$unit.service" ] || continue
			       echo -e "${YELLOW}>>> Перезапускаю $unit...${NC}"
			       systemctl restart "$unit" 2>/dev/null
			   done
               echo -e "${GREEN}✅ Обновлено! Перезапуск...${NC}"
               sleep 1
               exec bash "$0"
           else
               echo -e "${RED}❌ Ошибка обновления.${NC}"
               read -p "Нажмите Enter..."
           fi
           ;;
        [Xx])                                   
            echo -e "${GREEN}Выход в оболочку.${NC}"
            break
            ;;
        *)
            echo -e "${RED}❌ Неверный ввод.${NC}"
            sleep 1
            ;;
    esac
done
