# === СЕКРЕТЫ ботов ===
bots/.env
bots/.env.backup*
!bots/.env.example

# === ДАННЫЕ ботов ===
# базы содержат IP пользователей и токены доступа к VPN-панелям,
# GeoIP — ~175 МБ под лицензией MaxMind
bots/data/

# === ОКРУЖЕНИЕ ===
bots/venv/

# === PYTHON ===
__pycache__/
*.py[cod]

# === МУСОР ===
*.bak
*.bak[0-9]*
*.orig
*~
*.swp
.DS_Store

# === GEOIP ===
# Базы MaxMind: лицензия не разрешает перераспространение, а весят они
# десятки мегабайт и попадают в историю навсегда. Правило по расширению, а не
# по каталогу: прежнее ограничивалось bots/data/, и базы, положенные в
# bots/telemt/geoip/, оказались вне его — 83 МБ в одном `git add -A` от
# публичного репозитория.
*.mmdb

# Отчёты генераторов: одноразовые артефакты прогона, не содержимое проекта
.reports/

# === ТЕСТЫ ===
# Служебное от pytest и coverage: артефакты прогона, не содержимое проекта
.pytest_cache/
.coverage
.coverage.*
htmlcov/
