# Скопируйте в .env и заполните:  cp .env.example .env
# Обычно этот файл пишет установщик (пункт «Telegram-боты» в vsm).
# В репозиторий .env не попадает — см. .gitignore.

# --- Токены от @BotFather ---
# Нужен только тот, который соответствует выбранному режиму.
COMBINED_BOT_TOKEN=
TELEMT_BOT_TOKEN=
XUI_BOT_TOKEN=

# --- Доступ ---
# Telegram ID админов списком. Остальные игнорируются молча.
# Свой ID можно узнать у @userinfobot.
ADMIN_IDS=[123456789]

# --- Панель Telemt ---
TELEMT_API_URL=http://127.0.0.1:9091
TELEMT_API_KEY=
PROMETHEUS_METRICS_URL=http://127.0.0.1:9090/metrics
COLLECT_INTERVAL_MINUTES=1

# Сколько часов хранить историю IP. 0 — бессрочно (рекомендуется).
# Положительное значение включает очистку: записи об IP, не появлявшихся
# дольше указанного срока, УДАЛЯЮТСЯ безвозвратно.
ACTIVITY_RETENTION_HOURS=0

# --- Мониторинг панелей 3x-ui ---
XUI_CHECK_INTERVAL_SECONDS=60
XUI_FAILURES_BEFORE_ALERT=10

# --- Пути ---
# Задавать не нужно: по умолчанию считаются от каталога bots/ (см. config.py).
# Карта лежит вне репозитория: у /root права 700, nginx туда не попадёт.
MAP_HTML_PATH=/var/www/telemt-map/map.html
WEB_URL=
