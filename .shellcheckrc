# Настройка ShellCheck для VSM.
#
# Каждое отключение здесь — разобранный случай, а не способ добиться зелёного
# отчёта. Всё, что не перечислено, обязано быть исправлено: checks/shell.sh
# требует НОЛЬ замечаний уровня warning, иначе смысл проверки теряется.

# SC2034 — «переменная не используется». В VSM это неизбежно ложно: lib/*.sh
# сорсятся в меню, и переменная, объявленная в ui.sh, читается в menus/*.sh.
# ShellCheck такие связи не видит. Проверено вручную: из восьми срабатываний
# восемь ложные, включая AWG_TOOL_SHA — он сверяется в stacks/awg.sh:361 и при
# расхождении отменяет установку.
disable=SC2034

# SC1090, SC1091 — «не могу перейти по source». Пути собираются из VSM_LIB и
# VSM_ROOT, то есть вычисляются на ходу. Это устройство проекта, а не недосмотр.
disable=SC1090
disable=SC1091

# SC2119, SC2120 — «функция объявляет аргументы, но её зовут без них». Речь про
# wait_for_apt с необязательным таймаутом. Работает как задумано.
disable=SC2119
disable=SC2120

# SC2155 — «объявляй и присваивай раздельно, иначе маскируется код возврата».
# Во всех восьми местах дальше проверяется ЗНАЧЕНИЕ, а не код: `local port=$(…)`
# и следом `[ -n "$port" ]`. Код возврата там не нужен никому, а разделение
# строк добавило бы шума без единого исправленного случая.
disable=SC2155
